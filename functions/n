#!/usr/bin/env bash

n() {
  about 'Runs the package manager matching the lockfile in the current directory (bun, pnpm, yarn, npm; default pnpm)'
  param 'rest: package manager arguments'
  example '$ n install'
  group 'npm'

  if [[ -f bun.lock || -f bun.lockb ]]; then
    command bun "$@"
  elif [[ -f pnpm-lock.yaml ]]; then
    command pnpm "$@"
  elif [[ -f yarn.lock ]]; then
    command yarn "$@"
  elif [[ -f package-lock.json ]]; then
    command npm "$@"
  else
    command pnpm "$@"
  fi
}
