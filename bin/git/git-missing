#!/usr/bin/env bash

# grab the first two arguments as branches, the rest pass through to git log
for arg in "$@"; do
    if [ -z "$firstbranch" ]; then firstbranch="$arg"
    elif [ -z "$secondbranch" ]; then secondbranch="$arg"
    else passthrough="$passthrough $arg"
    fi
done

test -z "$firstbranch" && echo "at least one branch required" && exit 1

if test -z "$secondbranch"; then
    secondbranch=$firstbranch
    firstbranch=
fi

git log $passthrough $firstbranch...$secondbranch --format="%m %h %s" --left-right
